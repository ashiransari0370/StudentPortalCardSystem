# ================= BATCH 6 - Student Report Card System =================

# Step 1: Basic Info
student_name = input("Enter your name: ")
student_age = input("Enter your age: ")
student_batch = input("Enter your batch: ")

# Store and convert
student_age = int(student_age)
name = student_name  # for string operations

print(f"\nWelcome {name} from Batch {student_batch}!\n")

# ================= Step 2: String Operations =================
# 1. Remove extra spaces
clean_name = name.strip()
print(f"Cleaned Name: {clean_name}")
# 2. Uppercase
print(f"Name in Uppercase: {clean_name.upper()}")
# 3. Lowercase
print(f"Name in Lowercase: {clean_name.lower()}")
# 4. Count characters
print(f"Total characters in name: {len(clean_name)}")
# 5. Reverse name using slicing
print(f"Reversed name: {clean_name[::-1]}")
# 6. Count vowels
vowels = "aeiouAEIOU"
vowel_count = 0
for char in clean_name:
    if char in vowels:
        vowel_count += 1
print(f"Number of vowels in name: {vowel_count}\n")

# ================= Step 3: Subject Marks =================
subjects = ["Math", "English", "Science", "Computer", "Urdu"]
marks = []

for subject in subjects:
    while True:
        m = input(f"Enter marks for {subject} (0-100): ")
        m = int(m)
        if 0 <= m <= 100:
            marks.append(m)
            break
        else:
            print("Invalid! Marks must be between 0 and 100.")

# ================= Step 4: Calculations and Operators =================
total_marks = sum(marks)
percentage = (total_marks / (len(subjects) * 100)) * 100
average_marks = total_marks / len(subjects)
highest_mark = max(marks)
lowest_mark = min(marks)

# Check pass using comparison and logical operators
is_passed = percentage >= 50
has_passed_all = lowest_mark >= 50  # must pass in all subjects

print(f"\nTotal: {total_marks}, Percentage: {percentage:.2f}%, Average: {average_marks:.2f}")
print(f"Highest: {highest_mark}, Lowest: {lowest_mark}")

# ================= Step 5: Grade System =================
if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 50:
    grade = "D"
else:
    grade = "Fail"

if is_passed:
    status = "Passed"
else:
    status = "Failed"

# Distinction check
if percentage >= 90:
    distinction = "Yes - Qualifies for Distinction!"
else:
    distinction = "No"

print(f"Grade: {grade}, Status: {status}, Distinction: {distinction}")

# ================= Step 6: List Operations =================
print("\n--- List Operations ---")
print("Subjects:", subjects)
print("Marks:", marks)

# Add new subject
new_sub = input("\nEnter a new subject to add: ").strip()
subjects.append(new_sub)
while True:
    new_mark = int(input(f"Enter marks for {new_sub} (0-100): "))
    if 0 <= new_mark <= 100:
        marks.append(new_mark)
        break
    else:
        print("Invalid marks!")

# Update existing subject marks
update_sub = input(f"\nWhich subject marks you want to update? {subjects}: ").strip()
if update_sub in subjects:
    index = subjects.index(update_sub)
    while True:
        updated_mark = int(input(f"Enter new marks for {update_sub}: "))
        if 0 <= updated_mark <= 100:
            marks[index] = updated_mark
            break
        else:
            print("Invalid marks!")

# Remove a subject
remove_sub = input(f"\nWhich subject you want to remove? {subjects}: ").strip()
if remove_sub in subjects:
    idx = subjects.index(remove_sub)
    subjects.pop(idx)
    marks.pop(idx)
    print(f"{remove_sub} removed successfully.")

print("\nUpdated Subjects:", subjects)
print("Updated Marks:", marks)

# Recalculate after update for final report
total_marks = sum(marks)
percentage = (total_marks / (len(subjects) * 100)) * 100
average_marks = total_marks / len(subjects)
highest_mark = max(marks)
lowest_mark = min(marks)

# ================= Step 7: Loops Practice =================
print("\n--- Subjects with Marks ---")
for i in range(len(subjects)):
    print(f"{subjects[i]}: {marks[i]}")

# Count subjects above 80
above_80_count = 0
for m in marks:
    if m > 80:
        above_80_count += 1
print(f"\nNumber of subjects with marks above 80: {above_80_count}")

# Print numbers 1 to 10
print("\nNumbers from 1 to 10:")
for num in range(1, 11):
    print(num, end=" ")

# Multiplication Table
table_num = int(input("\n\nEnter a number for multiplication table: "))
print(f"\nMultiplication Table of {table_num}:")
for i in range(1, 11):
    print(f"{table_num} x {i} = {table_num * i}")

# ================= Step 8: Passed and Failed Subjects =================
passed_subjects = []
failed_subjects = []

for i in range(len(subjects)):
    if marks[i] >= 50:
        passed_subjects.append(subjects[i])
    else:
        failed_subjects.append(subjects[i])

print("\nPassed Subjects:", passed_subjects)
print("Failed Subjects:", failed_subjects)

# ================= Step 9: Final Report Card =================
print("\n========== FINAL REPORT CARD ==========")
print(f"Student Name: {clean_name}")
print(f"Age: {student_age}")
print(f"Batch: {student_batch}")
print("---------------------------------------")
for i in range(len(subjects)):
    print(f"{subjects[i]} : {marks[i]}")
print("---------------------------------------")
print(f"Total Marks: {total_marks} / {len(subjects)*100}")
print(f"Percentage: {percentage:.2f}%")
print(f"Average: {average_marks:.2f}")
print(f"Highest Mark: {highest_mark}")
print(f"Lowest Mark: {lowest_mark}")
print(f"Grade: {grade}")
print(f"Status: {status}")
print(f"Distinction: {distinction}")
print(f"Subjects above 80: {above_80_count}")
print(f"Passed Subjects List: {passed_subjects}")
print(f"Failed Subjects List: {failed_subjects}")
print("=======================================")

# ================= BONUS CHALLENGE =================
# Store multiple students and find topper
print("\n⭐ BONUS CHALLENGE - Multiple Students")
all_students = []
all_students.append((clean_name, percentage)) # add current student

choice = input("Do you want to add more students? (yes/no): ").lower()
while choice == "yes":
    s_name = input("\nEnter student name: ").strip()
    # For bonus we will take percentage directly to keep it short
    s_per = float(input(f"Enter percentage for {s_name}: "))
    all_students.append((s_name, s_per))
    choice = input("Add another? (yes/no): ").lower()

# Find student with highest percentage
if len(all_students) > 1:
    topper = all_students[0]
    for student in all_students:
        if student[1] > topper[1]:
            topper = student
    
    print("\n--- All Students Percentage ---")
    for s in all_students:
        print(f"{s[0]} : {s[1]}%")
    
    print(f"\nTopper is {topper[0]} with {topper[1]}%")
